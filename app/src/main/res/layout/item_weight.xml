<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the weight list: date, weight, edit button, delete button -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/rowDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:background="@drawable/row_border"
        android:padding="8dp"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/rowWeight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:background="@drawable/row_border"
        android:padding="8dp"
        android:textColor="@color/black" />

    <Button
        android:id="@+id/rowEditButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:backgroundTint="@color/blue_btn"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="Edit"
        android:textColor="@color/black"
        android:textSize="12sp" />

    <Button
        android:id="@+id/rowDeleteButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:backgroundTint="@color/blue_btn"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="Delete"
        android:textColor="@color/black"
        android:textSize="12sp" />
</LinearLayout>